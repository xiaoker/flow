{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow.xiaoker.com/schemas/recovery-inventory-v1.json",
  "title": "Flow R0-D recovery inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "request", "status", "hasMore", "nextCursor", "dates", "usage", "evidenceCoverage", "incompleteReasons", "r2Pagination", "r2HeadReceipts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "recovery-inventory-v1" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "cursor", "limit", "r2Cursor"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "cursor": { "type": ["string", "null"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "r2Cursor": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "status": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "hasMore": { "type": "boolean" },
    "nextCursor": { "type": ["string", "null"] },
    "r2Pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "nextCursor", "hasMore", "pageSize", "candidateCount", "indexSha256"],
      "properties": {
        "cursor": { "type": ["string", "null"], "maxLength": 256 },
        "nextCursor": { "type": ["string", "null"], "maxLength": 256 },
        "hasMore": { "type": "boolean" },
        "pageSize": { "type": "integer", "minimum": 0, "maximum": 64 },
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "indexSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "r2HeadReceipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asOf", "releaseId", "slot", "artifactName", "key", "declaredSha256", "declaredBytes", "status", "actualSha256", "actualBytes", "error"],
        "properties": {
          "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "releaseId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "slot": { "enum": ["dashboard", "etf_penetration"] },
          "artifactName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "key": { "type": "string", "minLength": 1, "maxLength": 512 },
          "declaredSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "declaredBytes": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["READY", "MISSING", "HASH_MISSING", "HASH_MISMATCH", "INCOMPLETE"] },
          "actualSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
          "actualBytes": { "type": ["integer", "null"], "minimum": 0 },
          "error": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    },
    "activeReleaseSlots": { "type": "array" },
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataDate", "domains", "releases", "sourceReadiness", "artifactPointers", "pipelineWindows", "recoveries", "marketHistory", "dateVisible"],
        "properties": {
          "dataDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "domains": { "type": "array" },
          "releases": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dashboard", "etf_penetration"],
            "properties": {
              "dashboard": { "type": "array" },
              "etf_penetration": { "type": "array" }
            }
          },
          "sourceReadiness": { "type": "array" },
          "artifactPointers": { "type": "array" },
          "pipelineWindows": { "type": "array" },
          "recoveries": { "type": "array" },
          "marketHistory": { "type": ["object", "null"] },
          "dateVisible": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "evidence"],
            "properties": {
              "status": { "enum": ["READY", "MISSING", "SOURCE_UNAVAILABLE", "UNKNOWN", "INCOMPLETE", "HASH_MISSING", "HASH_MISMATCH"] },
              "evidence": { "type": "array" }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["d1", "r2", "truncated"],
      "properties": {
        "d1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queryCount", "rowsRead", "rowsWritten", "rowsReadKnown", "rowsWrittenKnown"],
          "properties": {
            "queryCount": { "type": "integer", "minimum": 0, "maximum": 12 },
            "rowsRead": { "type": ["integer", "null"], "minimum": 0 },
            "rowsWritten": { "type": ["integer", "null"], "minimum": 0 },
            "rowsReadKnown": { "type": "boolean" },
            "rowsWrittenKnown": { "type": "boolean" }
          }
        },
        "r2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classA", "classB", "headCount", "headLimit"],
          "properties": {
            "classA": { "const": 0 },
            "classB": { "type": "integer", "minimum": 0 },
            "headCount": { "type": "integer", "minimum": 0, "maximum": 64 },
            "headLimit": { "const": 64 }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "evidenceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historicalSnapshots", "dashboardSnapshots", "releaseManifests", "sourceReadiness", "artifactPointers", "models", "marketHistory", "pipelineWindows", "recoveries", "activeReleaseSlots"],
      "properties": {
        "historicalSnapshots": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "dashboardSnapshots": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "releaseManifests": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "sourceReadiness": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "artifactPointers": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "models": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "marketHistory": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "pipelineWindows": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "recoveries": { "$ref": "#/$defs/evidenceCoverageEntry" },
        "activeReleaseSlots": { "$ref": "#/$defs/evidenceCoverageEntry" }
      }
    },
    "incompleteReasons": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETE" } } },
      "then": { "properties": { "incompleteReasons": { "maxItems": 0 }, "usage": { "properties": { "truncated": { "const": false } } } } }
    }
  ],
  "$defs": {
    "evidenceCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queried", "rowLimit", "returnedRows", "truncated", "reason"],
      "properties": {
        "queried": { "type": "boolean" },
        "rowLimit": { "type": ["integer", "null"], "minimum": 0 },
        "returnedRows": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "maxLength": 64 }
      }
    }
  }
}
