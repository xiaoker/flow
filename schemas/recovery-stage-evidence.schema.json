{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow.xiaoker.com/schemas/recovery-stage-evidence-v2.json",
  "title": "Controlled recovery stage evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "contractVersion",
    "phase",
    "status",
    "reconciliationStatus",
    "generatedAt",
    "planHash",
    "unknowns",
    "blockers",
    "nextAllowedAction",
    "protectedPathsTouched",
    "readOnlyAssertions",
    "budgetStatus",
    "budgetEvidenceMode",
    "localBudgetStatus",
    "accountBudgetStatus",
    "accountTelemetryEvidenceStatus",
    "migrationApplied",
    "sourceEvidenceStatus",
    "r2InventoryStatus"
  ],
  "properties": {
    "schemaVersion": {"const": "recovery-stage-evidence-v2"},
    "contractVersion": {"const": "recovery-audit-v2"},
    "phase": {"enum": ["R0-C", "R0-D"]},
    "status": {"enum": ["DONE", "DONE_WITH_CONCERNS", "BLOCKED"]},
    "reconciliationStatus": {"enum": ["NOT_APPLICABLE", "PENDING", "R0_RECONCILED"]},
    "generatedAt": {"type": "string"},
    "planHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "nextAllowedAction": {"enum": ["STOP", "R0-D_RECONCILE", "R2_ACCEPTANCE_AUDIT"]},
    "protectedPathsTouched": {"type": "array", "items": {"type": "string"}},
    "readOnlyAssertions": {
      "type": "object",
      "required": [
        "d1Writes",
        "r2Writes",
        "workflowDispatches",
        "activePointerChanges",
        "flagChanges"
      ],
      "properties": {
        "d1Writes": {"type": "integer", "minimum": 0},
        "r2Writes": {"type": "integer", "minimum": 0},
        "workflowDispatches": {"type": "integer", "minimum": 0},
        "activePointerChanges": {"type": "integer", "minimum": 0},
        "flagChanges": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "migrationApplied": {"const": false},
    "sourceEvidenceStatus": {
      "enum": ["READY", "READY_WITH_EVIDENCED_UNAVAILABLE", "INCOMPLETE"]
    },
    "budgetStatus": {"enum": ["allow", "unknown_metrics", "over_budget"]},
    "budgetEvidenceMode": {"enum": ["ACCOUNT_VERIFIED", "LOCAL_BOUNDED", "UNVERIFIED"]},
    "localBudgetStatus": {"enum": ["allow", "unknown_metrics", "over_budget"]},
    "accountBudgetStatus": {"enum": ["allow", "unknown_metrics", "over_budget"]},
    "accountTelemetryEvidenceStatus": {"type": "string", "maxLength": 64}
  },
  "oneOf": [
    {
      "properties": {
        "phase": {"const": "R0-C"},
        "status": {"enum": ["DONE", "DONE_WITH_CONCERNS"]},
        "reconciliationStatus": {"const": "NOT_APPLICABLE"},
        "nextAllowedAction": {"enum": ["STOP", "R0-D_RECONCILE"]}
      }
    },
    {
      "properties": {
        "phase": {"const": "R0-C"},
        "status": {"const": "BLOCKED"},
        "reconciliationStatus": {"const": "PENDING"},
        "nextAllowedAction": {"const": "STOP"}
      }
    },
    {
      "properties": {
        "phase": {"const": "R0-D"},
        "status": {"const": "BLOCKED"},
        "reconciliationStatus": {"const": "PENDING"},
        "nextAllowedAction": {"const": "STOP"}
      }
    },
    {
      "properties": {
        "phase": {"const": "R0-D"},
        "status": {"const": "DONE_WITH_CONCERNS"},
        "reconciliationStatus": {"const": "PENDING"},
        "nextAllowedAction": {"const": "R0-D_RECONCILE"}
      }
    },
    {
      "properties": {
        "phase": {"const": "R0-D"},
        "status": {"const": "DONE"},
        "reconciliationStatus": {"const": "R0_RECONCILED"},
        "nextAllowedAction": {"const": "R2_ACCEPTANCE_AUDIT"},
        "unknowns": {"const": []},
        "blockers": {"const": []},
        "protectedPathsTouched": {"const": []},
        "readOnlyAssertions": {
          "properties": {
            "d1Writes": {"const": 0},
            "r2Writes": {"const": 0},
            "workflowDispatches": {"const": 0},
            "activePointerChanges": {"const": 0},
            "flagChanges": {"const": 0}
          }
        },
        "migrationApplied": {"const": false},
        "budgetStatus": {"const": "allow"},
        "budgetEvidenceMode": {"const": "ACCOUNT_VERIFIED"},
        "localBudgetStatus": {"const": "allow"},
        "accountBudgetStatus": {"const": "allow"},
        "accountTelemetryEvidenceStatus": {"const": "VALID"},
        "r2InventoryStatus": {"const": "READY"}
      }
    }
  ]
}
