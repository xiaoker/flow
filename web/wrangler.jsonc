{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flow",
  "account_id": "21004860faeebc5fa4f297679796ee00",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "flow.xiaoker.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["15 10 * * mon-fri", "15 15 * * mon-fri", "30 1,2 * * mon-fri"]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flow",
      "database_id": "6b85c600-8a90-4cc2-8742-c0df4392c6aa",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "flow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
