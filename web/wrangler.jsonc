{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flow",
  "account_id": "21004860faeebc5fa4f297679796ee00",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "flow.xiaoker.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "30 10 * * mon-fri",
      "45 23 * * sun-thu",
      "45 0 * * mon-fri",
      "15 1 * * mon-fri",
      "15 11 * * mon-fri"
    ]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "PIPELINE_WINDOW_GATE_ENABLED": "1",
    "PIPELINE_WINDOW_CONTRACT_VERSION": "v1",
    "HISTORY_IMPORT_ARCHIVE_ONLY": "1",
    "SOURCE_OBSERVATION_SHADOW_ENABLED": "0",
    "MARKET_DAY_PROBE_ENABLED": "0",
    "R2_METADATA_REPAIR_ENABLED": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flow",
      "database_id": "6b85c600-8a90-4cc2-8742-c0df4392c6aa",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "flow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
